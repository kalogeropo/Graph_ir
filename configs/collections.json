      "relevance_profiles": {
        "graded": "qrels.tsv",
        "binary": "qrels-binary.tsv"
      },
      "default_relevance_profile": "graded",
      "binary_relevance_threshold": 1
    },
    "npl": {
      "path": "collections/npl",
