{
  "schema_version": 2,
  "path_base": "repository_root",
  "collections": {
    "cf": {
      "path": "collections/cf",
      "documents": "corpus.jsonl",
      "queries": "queries.jsonl",
      "relevance": "qrels.tsv",
      "status": "benchmark",
      "relevance_profiles": {
        "binary": "qrels.tsv",
        "assessor-1": "qrels-assessor-1.tsv",
        "assessor-2": "qrels-assessor-2.tsv",
        "assessor-3": "qrels-assessor-3.tsv",
        "assessor-4": "qrels-assessor-4.tsv"
      },
      "default_relevance_profile": "binary",
      "binary_relevance_threshold": 1
    },
    "cranfield": {
      "path": "collections/cranfield",
      "documents": "corpus.jsonl",
      "queries": "queries.jsonl",
      "relevance": "qrels.tsv",
