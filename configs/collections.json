    },
    "baeza": {
      "path": "collections/baeza",
      "documents": "corpus.jsonl",
      "queries": "queries.jsonl",
      "relevance": "qrels.tsv",
      "status": "example"
    },
    "test": {
      "path": "collections/test",
      "documents": "corpus.jsonl",
      "queries": "queries.jsonl",
      "relevance": "qrels.tsv",
      "status": "example"
    }
  }
}
